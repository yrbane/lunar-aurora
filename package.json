{
  "name": "lunar-aurora",
  "version": "1.0.0",
  "description": "A disruptive CSS framework using avant-garde techniques: OKLCH, @property, CSS nesting, container queries, and more.",
  "main": "src/aurora.css",
  "style": "src/aurora.css",
  "files": [
    "src/**/*.css",
    "dist/**/*.css"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "postcss src/aurora.css -o dist/aurora.min.css --env production",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yrbane/lunar-aurora.git"
  },
  "keywords": [
    "css",
    "framework",
    "oklch",
    "css-nesting",
    "container-queries",
    "design-system",
    "lunar",
    "aurora",
    "modern-css"
  ],
  "author": "yrbane",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yrbane/lunar-aurora/issues"
  },
  "homepage": "https://github.com/yrbane/lunar-aurora#readme",
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "cssnano": "^6.0.1",
    "postcss": "^8.4.31",
    "postcss-cli": "^10.1.0",
    "postcss-import": "^15.1.0",
    "postcss-preset-env": "^10.5.0",
    "vite": "^7.2.6",
    "vitepress": "^1.6.4",
    "vue": "^3.5.25"
  }
}
